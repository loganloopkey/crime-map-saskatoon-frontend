# =============================================
# DATABASE CONNECTION - SUPABASE
# =============================================

# Get this from: Discord
# OR: Supabase Dashboard → Settings → Database → Connection Pooler
       
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres

# =============================================
# SERVER CONFIGURATION
# =============================================

# Port for the backend server
PORT=5000

# Environment (development/production)
NODE_ENV=development